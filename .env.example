# Webhook HTTP server
WEBHOOK_SERVER_PORT=4550

# Mock courier API
MOCK_COURIER_PORT=4600
# Deterministic failure injection for tests/dev: success | error_500 | rate_limit_429 | timeout_wait
# Leave unset for the default probabilistic behavior.
MOCK_COURIER_MODE=
MOCK_COURIER_RETRY_AFTER_MS=2000
MOCK_COURIER_TIMEOUT_DELAY_MS=10000

# Webhook HMAC secret (must match what Shopify would use)
SHOPIFY_WEBHOOK_SECRET=change-me

# Storage
DATABASE_PATH=./data/app.db
MOCK_COURIER_DATA_PATH=./data/mock-courier-shipments.json

# Courier client
COURIER_BASE_URL=http://localhost:4600
COURIER_TIMEOUT_MS=5000
COURIER_MAX_ATTEMPTS=5
COURIER_RETRY_BASE_DELAY_MS=500
COURIER_RETRY_MAX_DELAY_MS=30000
COURIER_RETRY_JITTER_MS=250

# Worker
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_MS=60000

# Ambiguity / reconciliation
UNCERTAINTY_DELAY_MS=5000
